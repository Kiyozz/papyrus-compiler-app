{
  "name": "pca",
  "version": "5.8.0",
  "private": true,
  "description": "Papyrus compiler app (PCA) by WushuLate",
  "license": "MIT",
  "author": "WK <kevinturmel@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git@github.com:Kiyozz/papyrus-compiler-app.git"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/renderer/*",
    "#main/*": "./src/main/*",
    "#common/*": "./src/common/*",
    "#event-handlers/*": "./src/main/event-handlers/*"
  },
  "scripts": {
    "dev": "electron-tsdown dev",
    "build": "pnpm lingui:extract && pnpm lingui:extract:main && pnpm lingui:compile:main && electron-tsdown build",
    "package": "electron-builder",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lingui:extract": "lingui extract",
    "lingui:extract:main": "lingui extract --config ./lingui.main.config.ts",
    "lingui:compile:main": "lingui compile --config ./lingui.main.config.ts",
    "changeset:version": "changeset version"
  },
  "devDependencies": {
    "@adonisjs/fold": "^11.0.0",
    "@babel/plugin-syntax-decorators": "^7.28.6",
    "@changesets/cli": "^2.31.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/figtree": "^5.2.10",
    "@lingui/babel-plugin-lingui-macro": "^5.9.5",
    "@lingui/cli": "^5.9.5",
    "@lingui/conf": "^5.9.5",
    "@lingui/core": "^5.9.5",
    "@lingui/react": "^5.9.5",
    "@lingui/vite-plugin": "^5.9.5",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@sindresorhus/is": "~7.0.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-router": "^1.168.22",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-virtual": "^3.13.24",
    "@tanstack/router-plugin": "^1.167.22",
    "@types/minimist": "^1.2.5",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-macros": "^3.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "classnames": "~2.5.1",
    "compare-versions": "~6.1.1",
    "debounce-fn": "~6.0.0",
    "deepmerge": "~4.3.1",
    "electron": "^41.2.1",
    "electron-builder": "~26.8.1",
    "electron-context-menu": "^4.1.2",
    "electron-default-menu": "~1.0.2",
    "electron-fetch": "^1.9.1",
    "electron-log": "~5.4.3",
    "electron-store": "~11.0.2",
    "electron-tsdown": "^11.0.4",
    "electron-util": "~1.0.0",
    "emittery": "^2.0.0",
    "fast-glob": "~3.3.3",
    "kkrpc": "^0.6.7",
    "lefthook": "^2.1.6",
    "lucide-react": "^1.8.0",
    "minimist": "^1.2.8",
    "move-file": "~4.1.0",
    "next-themes": "^0.4.6",
    "os-locale": "^8.0.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.60.0",
    "queue": "^7.0.0",
    "radix-ui": "^1.4.3",
    "react": "~19.2.5",
    "react-dom": "~19.2.5",
    "react-dropzone": "^14.4.1",
    "react-hook-form": "^7.72.1",
    "react-markdown": "~10.1.0",
    "react-use-localstorage": "^3.5.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "~6.1.3",
    "rooks": "^9.8.0",
    "rxjs": "~7.8.2",
    "shadcn": "^4.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "~4.2.2",
    "ts-pattern": "^5.9.0",
    "tsdown": "^0.21.9",
    "tw-animate-css": "^1.4.0",
    "type-fest": "^5.6.0",
    "typescript": "~6.0.3",
    "unplugin-fonts": "^2.0.0",
    "uuid": "^13.0.0",
    "vite": "^8.0.8",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@10.11.0",
  "build": {
    "appId": "io.kiyozz.pca",
    "productName": "PCA",
    "copyright": "Copyright © WushuLate",
    "afterPack": "./build/after-pack.js",
    "artifactName": "${productName}.${ext}",
    "extraMetadata": {
      "name": "PCA",
      "main": "main.js"
    },
    "files": [
      {
        "from": ".",
        "filter": [
          "package.json"
        ]
      },
      {
        "from": "dist/main"
      },
      {
        "from": "dist/renderer"
      }
    ],
    "win": {
      "target": [
        "7z"
      ]
    },
    "directories": {
      "buildResources": "resources"
    },
    "publish": null
  }
}
