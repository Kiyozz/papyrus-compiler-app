{
  "name": "pca",
  "version": "5.8.0",
  "description": "Papyrus compiler app (PCA) by WushuLate",
  "private": true,
  "scripts": {
    "dev": "electron-esbuild dev",
    "build": "electron-esbuild build",
    "package": "electron-builder",
    "lint": "eslint src --ext .ts,.tsx",
    "prepare": "husky"
  },
  "engines": {
    "node": "22",
    "pnpm": "10"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:Kiyozz/papyrus-compiler-app.git"
  },
  "author": "WK <kevinturmel@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@emotion/react": "^11.10.0",
    "@emotion/styled": "^11.10.0",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/roboto": "^5.2.5",
    "@mui/icons-material": "^5.8.4",
    "@mui/material": "^5.9.3",
    "@pca/electron-ipc": "workspace:*",
    "@sindresorhus/is": "~7.0.1",
    "@types/lodash-es": "~4.17.6",
    "@types/minimist": "^1.2.2",
    "@types/react": "~19.1.4",
    "@types/react-dom": "~19.1.5",
    "@types/react-router": "^5.1.18",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-transition-group": "^4.4.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "~10.4.8",
    "classnames": "~2.5.1",
    "compare-versions": "~6.1.1",
    "debounce-fn": "~6.0.0",
    "deepmerge": "~4.3.1",
    "electron": "^36.2.1",
    "electron-builder": "~26.0.12",
    "electron-context-menu": "^4.0.5",
    "electron-default-menu": "~1.0.2",
    "electron-esbuild": "^10.0.0",
    "electron-fetch": "^1.7.4",
    "electron-log": "~5.4.0",
    "electron-store": "~10.0.1",
    "electron-util": "~0.18.1",
    "esbuild": "^0.25.4",
    "fast-glob": "~3.3.3",
    "history": "^5.3.0",
    "husky": "~9.1.7",
    "i18next": "~21.8.16",
    "i18next-browser-languagedetector": "~6.1.4",
    "lint-staged": "~16.0.0",
    "minimist": "^1.2.6",
    "move-file": "~3.1.0",
    "os-locale": "^6.0.2",
    "path-shorten": "^0.1.2",
    "postcss": "~8.5.3",
    "queue": "^7.0.0",
    "react": "~19.1.0",
    "react-dom": "~19.1.0",
    "react-dropzone": "^14.2.2",
    "react-i18next": "~15.5.1",
    "react-markdown": "~10.1.0",
    "react-router-dom": "^7.6.0",
    "react-transition-group": "^4.4.5",
    "react-use-localstorage": "^3.5.3",
    "rimraf": "~6.0.1",
    "rooks": "^8.0.1",
    "rxjs": "~7.8.2",
    "tailwindcss": "~3.1.7",
    "ts-pattern": "^5.7.1",
    "type-fest": "^4.41.0",
    "typescript": "~5.8.3",
    "uuid": "^11.1.0",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "io.kiyozz.pca",
    "productName": "PCA",
    "copyright": "Copyright © WushuLate",
    "afterPack": "./build/after-pack.js",
    "artifactName": "${productName}.${ext}",
    "extraMetadata": {
      "name": "PCA",
      "main": "main.js"
    },
    "files": [
      {
        "from": ".",
        "filter": [
          "package.json"
        ]
      },
      {
        "from": "dist/main"
      },
      {
        "from": "dist/renderer"
      }
    ],
    "win": {
      "target": [
        "7z"
      ]
    },
    "directories": {
      "buildResources": "resources"
    },
    "publish": null
  },
  "packageManager": "pnpm@10.11.0",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.511.0",
    "tailwind-merge": "^3.3.0",
    "tw-animate-css": "^1.3.0"
  }
}
