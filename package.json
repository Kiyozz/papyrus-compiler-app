{
  "name": "pca",
  "version": "5.9.0",
  "private": true,
  "description": "Papyrus compiler app (PCA) by WushuLate",
  "license": "MIT",
  "author": "WK <kevinturmel@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git@github.com:Kiyozz/papyrus-compiler-app.git"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/renderer/*",
    "#main/*": "./src/main/*",
    "#common/*": "./src/common/*",
    "#event-handlers/*": "./src/main/event-handlers/*"
  },
  "scripts": {
    "dev": "electron-tsdown dev",
    "build": "pnpm lingui:extract && pnpm lingui:extract:main && pnpm lingui:compile:main && electron-tsdown build",
    "package": "electron-builder",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lingui:extract": "lingui extract",
    "lingui:extract:main": "lingui extract --config ./lingui.main.config.ts",
    "lingui:compile:main": "lingui compile --config ./lingui.main.config.ts",
    "changeset:version": "changeset version && node scripts/public-version.mjs",
    "changeset:tag": "changeset git-tag"
  },
  "devDependencies": {
    "@adonisjs/fold": "^11.1.0",
    "@babel/core": "^8.0.1",
    "@babel/plugin-syntax-decorators": "^8.0.1",
    "@base-ui/react": "^1.7.0",
    "@changesets/cli": "^3.0.1",
    "@fontsource/figtree": "^5.3.0",
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@lingui/cli": "^6.6.0",
    "@lingui/conf": "^6.6.0",
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@lingui/vite-plugin": "^6.6.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@sindresorhus/is": "~8.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-virtual": "^3.14.10",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/minimist": "^1.2.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.5",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-macros": "^3.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "classnames": "~2.5.1",
    "compare-versions": "~6.1.1",
    "debounce-fn": "~6.0.0",
    "deepmerge": "~4.3.1",
    "electron": "^44.0.0",
    "electron-builder": "~26.15.7",
    "electron-context-menu": "^4.1.2",
    "electron-default-menu": "~1.0.2",
    "electron-log": "~5.4.4",
    "electron-store": "~11.0.2",
    "electron-tsdown": "^12.0.1",
    "electron-util": "~1.0.0",
    "emittery": "^2.0.0",
    "kkrpc": "^2.1.0",
    "lefthook": "^2.1.12",
    "lucide-react": "^1.37.0",
    "minimist": "^1.2.8",
    "move-file": "~4.1.0",
    "next-themes": "^0.4.6",
    "os-locale": "^8.0.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "queue": "^7.0.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-hook-form": "^7.86.0",
    "react-markdown": "~10.1.0",
    "react-use-localstorage": "^3.5.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "~6.1.3",
    "rooks": "^9.9.0",
    "rxjs": "~7.8.2",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "~4.3.3",
    "ts-pattern": "^5.9.0",
    "tsdown": "^0.22.14",
    "tw-animate-css": "^1.4.0",
    "type-fest": "^5.8.0",
    "typescript": "~7.0.2",
    "unplugin-fonts": "^2.0.0",
    "uuid": "^14.0.2",
    "vite": "^8.2.2",
    "yauzl": "^3.4.0",
    "zod": "^4.5.2"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@12.1.0",
  "build": {
    "appId": "io.kiyozz.pca",
    "productName": "PCA",
    "copyright": "Copyright © WushuLate",
    "afterPack": "./build/after-pack.js",
    "artifactName": "${productName}.${ext}",
    "extraMetadata": {
      "name": "PCA",
      "main": "main.js"
    },
    "files": [
      {
        "from": ".",
        "filter": [
          "package.json"
        ]
      },
      {
        "from": "dist/main"
      },
      {
        "from": "dist/renderer"
      }
    ],
    "win": {
      "target": [
        "7z"
      ]
    },
    "directories": {
      "buildResources": "resources"
    },
    "publish": null
  },
  "publicVersion": "2026.1"
}
